{
  "name": "kuro-cat-pet",
  "version": "5.1.0",
  "private": true,
  "description": "Adorable transparent black cat desktop typing & mouse companion for Windows and macOS",
  "type": "module",
  "scripts": {
    "test:swat": "node --test tests/headPatSwat.test.mjs",
    "test:swat:browser": "node scripts/verify-head-pat-swat.mjs",
    "test:back-markings": "node scripts/verify-back-markings.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "build:facai": "tsc && vite build --mode facai --outDir dist-facai",
    "build:android-web": "vite build --config vite.android.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:facai": "tauri build --config src-tauri/tauri.facai.json --features facai-only --target x86_64-pc-windows-msvc --no-bundle --no-sign",
    "tauri:build:facai:macos": "tauri build --config src-tauri/tauri.facai.json --config src-tauri/tauri.facai.macos.json --features facai-only --target universal-apple-darwin --bundles app --no-sign -- --locked",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@types/three": "^0.187.0",
    "playwright": "1.65.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
